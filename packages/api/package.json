{
  "name": "@lakehouse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/lambda-adapter.ts src/lambda-worker.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --out-extension:.js=.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --external:@aws-sdk/*",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.900.0",
    "@aws-sdk/client-bedrock-runtime": "^3.900.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.900.0",
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/client-lambda": "^3.900.0",
    "@aws-sdk/client-sfn": "^3.1156.0",
    "@aws-sdk/client-ssm": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@lakehouse/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.150",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
